<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay of the network security policy (replaces the main
  config for dev-signed builds):

  - Cleartext allowed ONLY for loopback targets: localhost and 10.0.2.2
    (emulator → host loopback), so a locally-run API server can be tested.
  - No pin enforcement here; pins are added to the main config in
    Phase 0.4 and intentionally never apply to debug builds (roadmap:
    "disable on dev-signed APK").
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
